Output demo.gif

# Set a nice terminal size and theme first
Set FontSize 16
Set Width 1200
Set Height 600
Set Theme "Dracula"

# Type slower so viewers can actually read it
Set TypingSpeed 50ms

Type "cmdock log"
Enter
Sleep 2s

# Open search
Type "/"
Sleep 500ms

Type "git"
Sleep 500ms

Enter
Sleep 3s

# hold on the final result so it doesn't cut off abruptly
Sleep 2s